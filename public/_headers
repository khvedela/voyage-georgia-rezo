# Cloudflare Pages / Netlify header rules. Other hosts: replicate these in their config.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Fingerprinted build output never changes: cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable-URL static assets: a week, then revalidate in the background.
/maps/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/terrain/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og/*
  Cache-Control: public, max-age=86400

# Machine-readable files: short cache so updates reach crawlers quickly.
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Private areas: never indexed (robots.txt also disallows crawling).
/studio
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
/studio/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
/trip/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: private, no-store
