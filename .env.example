# Canonical origin (no trailing slash). Drives canonicals, sitemap, JSON-LD, Open Graph.
PUBLIC_SITE_URL=https://voyagegeorgiarezo.com

# Contact channels. Leave blank to hide a channel everywhere (including structured data).
PUBLIC_WHATSAPP=            # international digits only, e.g. 995555000000
PUBLIC_EMAIL=
PUBLIC_MESSENGER_URL=       # https://m.me/<page>
PUBLIC_FACEBOOK_URL=
PUBLIC_INSTAGRAM_URL=
PUBLIC_GOOGLE_BUSINESS_URL= # Google Business Profile (service-area) URL, used as schema sameAs

# Where "Send to Rezo" posts JSON (Formspree, Web3Forms, your own function...).
# If blank, the form falls back to WhatsApp / email deep links.
PUBLIC_INQUIRY_ENDPOINT=

# Show bracketed "[to be verified]" placeholders on the public site (always on in `astro dev`).
PUBLIC_SHOW_PLACEHOLDERS=false
