---
import { Image } from 'astro:assets';
import { photos, type PhotoId } from '../data/photos';
interface Props { id: PhotoId; eager?: boolean; ratio?: string; sizes?: string; class?: string }
const { id, eager = false, ratio = '4 / 3', sizes = '(min-width: 1000px) 560px, 100vw', class: cls } = Astro.props;
const p = photos[id];
---
<figure class:list={['pf', cls]} style="margin:0">
  <Image src={p.src} alt={p.alt} widths={[480, 768, 1100]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding={eager ? 'sync' : 'async'} style={`aspect-ratio:${ratio};width:100%;height:auto;object-fit:cover;border-radius:14px;display:block`} />
  <figcaption><a href={p.creditUrl} target="_blank" rel="noopener">{p.credit}</a></figcaption>
</figure>
<style>
  figcaption { margin-top: 8px; font-size: 11.5px; line-height: 1.35; }
  figcaption a { color: var(--muted); text-decoration: none; }
  figcaption a:hover { color: var(--ink); text-decoration: underline; }
</style>
