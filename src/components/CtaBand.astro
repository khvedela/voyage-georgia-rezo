---
import { getLang, l, useT } from '../i18n';
interface Props { title?: string; text?: string; sample?: string }
const lang = getLang(Astro);
const t = useT(lang);
const { title = t.common.cta.title, text = t.common.cta.text, sample } = Astro.props;
const href = l(lang, sample ? `/design-my-trip?sample=${sample}` : '/design-my-trip');
---
<section class="section section--ink cta-band" aria-label={t.common.cta.label}>
  <div class="wrap" style="display:flex;flex-wrap:wrap;gap:24px 56px;align-items:center;justify-content:space-between">
    <div style="flex:1 1 420px">
      <h2 class="h-lg" style="color:#fff;margin-bottom:14px">{title}</h2>
      <p style="margin:0;max-width:520px;font-size:18px;color:#cfcac3">{text}</p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:12px">
      <a href={href} class="btn btn--primary">{t.common.cta.designTrip}</a>
      <a href={l(lang, '/contact')} class="btn btn--ghost-light" style="min-height:56px">{t.common.cta.message}</a>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: clamp(48px, 6vw, 80px); }
</style>
