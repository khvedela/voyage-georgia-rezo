---
import ArrowIcon from './ArrowIcon.astro';
interface Props { title?: string; text?: string; sample?: string }
const { title = 'Tell Rezo what you imagine.', text = 'Free, about three minutes, and nothing is booked. He reads every request himself and plans the real trip with you.', sample } = Astro.props;
const href = sample ? `/design-my-trip?sample=${sample}` : '/design-my-trip';
---
<section class="section section--ink cta-band" aria-label="Start planning">
  <div class="wrap" style="display:flex;flex-wrap:wrap;gap:24px 56px;align-items:center;justify-content:space-between">
    <div style="flex:1 1 420px">
      <h2 style="font-weight:700;font-size:clamp(30px,3.6vw,48px);line-height:1;letter-spacing:-.03em;margin-bottom:14px">{title}</h2>
      <p style="margin:0;max-width:520px;font-size:17.5px;color:var(--line-2)">{text}</p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:12px">
      <a href={href} class="btn btn--primary">Design my trip <ArrowIcon /></a>
      <a href="/contact" class="btn btn--ghost-light" style="min-height:56px">Message Rezo</a>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: clamp(48px, 6vw, 80px); }
</style>
