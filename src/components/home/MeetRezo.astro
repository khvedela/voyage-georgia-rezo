---
import PhotoSlot from '../PhotoSlot.astro';
import Todo from '../Todo.astro';
import { site } from '../../config/site';
interface Props { heading?: 'h1' | 'h2'; link?: boolean }
const { heading = 'h2', link = true } = Astro.props;
const H = heading;
---
<section id="rezo" class="section section--mist" aria-labelledby="rezo-h">
  <div class="wrap" style="display:flex;flex-wrap:wrap;gap:48px clamp(32px,6vw,96px);align-items:center">
    <div style="flex:1 1 320px;max-width:460px">
      <div class="plinth" style="padding:12px"><PhotoSlot label="Portrait photo of Rezo goes here, ideally on the road, in daylight." ratio="4 / 5" size={40} style="border-radius:12px;padding:24px" /></div>
    </div>
    <div style="flex:1 1 440px;min-width:0">
            <H id="rezo-h" class="h-md" style="margin-bottom:24px;font-size:clamp(34px,4.2vw,58px);line-height:1">The person who plans your journey is the person you message.</H>
      <p style="margin:0 0 16px;font-size:19px;color:var(--slate-2);max-width:620px">Rezo owns and personally runs Voyage Georgia Rezo. He has worked in Georgian tourism for more than twenty years and is an experienced private tour guide. Drivers he works with help deliver your tours and transfers.</p>
      <p style="margin:0 0 32px;font-size:16px;color:var(--slate);max-width:620px"><Todo>Rezo’s own words about why he does this — to be written with him.</Todo></p>
      <dl class="stat-grid">
        <div><dt>20+ years</dt><dd>in Georgian tourism</dd></div>
        <div><dt>Hand-built</dt><dd>routes, schedules and prices</dd></div>
        {site.showPlaceholders && <div><dt><Todo>Licence</Todo></dt><dd>guide credentials — to verify</dd></div>}
      </dl>
      {link && <p style="margin:28px 0 0"><a href="/rezo" class="lnk">More about Rezo</a></p>}
    </div>
  </div>
</section>
<style>
  .stat-grid { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 20px 28px; }
  .stat-grid > div { padding: 16px 18px 18px; background: var(--paper); border-radius: 14px; box-shadow: 0 3px 0 var(--plaster-d); }
  .stat-grid dt { font: 520 28px/1.1 var(--font-serif); letter-spacing: -.015em; }
  .stat-grid dd { margin: 6px 0 0; font: 400 14.5px/1.4 var(--font-ui); color: var(--slate); }
</style>
