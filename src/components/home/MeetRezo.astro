---
import PhotoSlot from '../PhotoSlot.astro';
import Todo from '../Todo.astro';
import { site } from '../../config/site';
import { getLang, l, useT } from '../../i18n';
const lang = getLang(Astro);
const m = useT(lang).common.meetRezo;
interface Props { heading?: 'h1' | 'h2'; link?: boolean }
const { heading = 'h2', link = true } = Astro.props;
const H = heading;
---
<section id="rezo" class="section section--mist" aria-labelledby="rezo-h">
  <div class="wrap" style="display:flex;flex-wrap:wrap;gap:48px clamp(32px,6vw,96px);align-items:center">
    <div style="flex:1 1 320px;max-width:460px">
      <div class="plinth" style="padding:12px"><PhotoSlot label={m.photo} ratio="4 / 5" size={40} style="border-radius:12px;padding:24px" /></div>
    </div>
    <div style="flex:1 1 440px;min-width:0">
            <H id="rezo-h" class="h-md" style="margin-bottom:24px;font-size:clamp(34px,4.2vw,58px);line-height:1">{m.title}</H>
      <p style="margin:0 0 16px;font-size:19px;color:var(--slate-2);max-width:620px">{m.text}</p>
      <p style="margin:0 0 32px;font-size:16px;color:var(--slate);max-width:620px"><Todo>{m.wordsTodo}</Todo></p>
      <dl class="stat-grid">
        <div><dt>{m.years}</dt><dd>{m.yearsNote}</dd></div>
        <div><dt>{m.handBuilt}</dt><dd>{m.handBuiltNote}</dd></div>
        {site.showPlaceholders && <div><dt><Todo>{m.licenceTodo}</Todo></dt><dd>{m.licenceNote}</dd></div>}
      </dl>
      {link && <p style="margin:28px 0 0"><a href={l(lang, '/rezo')} class="lnk">{m.more}</a></p>}
    </div>
  </div>
</section>
<style>
  .stat-grid { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 20px 28px; }
  .stat-grid > div { padding: 16px 18px 18px; background: var(--paper); border-radius: 14px; box-shadow: 0 3px 0 var(--plaster-d); }
  .stat-grid dt { font: 520 28px/1.1 var(--font-serif); letter-spacing: -.015em; }
  .stat-grid dd { margin: 6px 0 0; font: 400 14.5px/1.4 var(--font-ui); color: var(--slate); }
</style>
