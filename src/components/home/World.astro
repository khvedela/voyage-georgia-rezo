---
/**
 * The homepage is built around the model. One sticky stage holds the canvas and three layers:
 *   pick   the whole model; tap regions to plant flags, and a tray collects them for Rezo
 *   drive  scrolling scrubs a sample route: the road draws itself behind a van; one card names the stop or the leg
 *   outro  pulled back over the finished route, with the way to plan your own
 * All copy is server-rendered. Without WebGL the stage shows a still render of the model, the picker still works
 * as a row of chips, and the drive becomes an ordinary list (see .world.is-flat).
 */
import { Image } from 'astro:assets';
import { regions, stops, legs } from '../../data/drive';
import { modelViews, overviewView } from '../../data/model';
const stopImg = (key: string) => modelViews[key === 'kutaisi' ? 'kutaisi-imereti' : key === 'batumi' ? 'batumi-adjara' : key];
---
<section class="world" id="model" aria-label="Georgia on a model: pick your places, then scroll through a sample route" data-phase="pick">
  <div class="w-stage">
    <div class="w-still" aria-hidden="true">
      <Image src={overviewView.src} alt="" widths={[640, 960]} sizes="(min-width: 900px) 70vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
    <canvas id="world3d" role="img" aria-label="A three-dimensional model of Georgia. Regions you pick are marked with red flags; scrolling drives a sample route across it."></canvas>

    <!-- pick: the opening -->
    <div class="w-pick">
      <div class="w-intro">
        <h1 class="w-h1">Your Georgia, designed by Rezo.</h1>
        <p class="w-lead">Tap the places that call to you and plant a flag. Rezo, a private guide with twenty years on these roads, plans the days between them himself.</p>
      </div>

      <div class="w-labels" role="group" aria-label="Regions on the model">
        {regions.map((r) => (
          <button type="button" class="w-label" data-region={r.id} aria-pressed="false">
            <span class="w-label-in">
              <span class="w-tick" aria-hidden="true"></span>
              <span class="w-name">{r.name}</span>
            </span>
          </button>
        ))}
      </div>

      <div class="w-tray" aria-live="polite">
        <div class="w-tray-txt">
          <p class="w-tray-k">Your trip</p>
          <p class="w-tray-v" data-tray-list>Nothing picked yet. Tap a region on the model.</p>
        </div>
        <a href="/design-my-trip" class="btn btn--primary" data-tray-go>Design my trip</a>
      </div>

      <p class="w-cue"><span class="w-cue-ico" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></span>Scroll to follow a sample route</p>
      <p class="w-hint" aria-hidden="true">Drag to turn the model</p>
    </div>

    <!-- drive: one card at a time -->
    <div class="w-drive">
      <ol class="w-cards">
        {stops.map((s, i) => (
          <li class="w-card w-stop" data-card={`s${i}`}>
            <div class="w-card-img">
              <Image src={stopImg(s.key).src} alt={stopImg(s.key).alt} widths={[480, 720]} sizes="(min-width: 900px) 400px, 100vw" loading="lazy" decoding="async" />
            </div>
            <p class="w-card-place"><span class="w-num" aria-hidden="true">{i + 1}</span>{s.name}<span class="sr-only">, stop {i + 1} of {stops.length}</span></p>
            <h2 class="w-card-h">{s.title}</h2>
            <p class="w-card-p">{s.line}</p>
            <dl class="w-facts">{s.facts.map(([v, k]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <a href={s.href} class="lnk">More about {s.name}</a>
          </li>
        ))}
        {legs.map((l, i) => (
          <li class="w-card w-leg" data-card={`l${i}`}>
            <p class="w-leg-route"><span>{stops[i].name}</span><span class="w-leg-line" aria-hidden="true"></span><span class="sr-only"> to </span><span>{stops[i + 1].name}</span></p>
            <p class="w-leg-d"><strong>{l.dist}</strong> {l.time}</p>
            <p class="w-leg-v">{l.via}</p>
          </li>
        ))}
      </ol>

      <nav class="w-bar" aria-label="Stops on the sample route">
        <div class="w-bar-track" aria-hidden="true"><i data-bar-fill></i></div>
        <ol>
          {stops.map((s, i) => (
            <li><button type="button" class="w-dot" data-stop={i} aria-current="false"><span class="w-dot-n">{i + 1}</span><span class="w-dot-t">{s.name}</span></button></li>
          ))}
        </ol>
      </nav>
    </div>

    <!-- outro -->
    <div class="w-outro">
      <div class="w-outro-card plinth">
        <h2 class="w-outro-h">That was one route. Yours will be different.</h2>
        <p>Add a week in the mountains, drop the sea, stay longer at the table. Rezo builds the route around you, schedules every day and prices it himself.</p>
        <div class="w-outro-cta">
          <a href="/design-my-trip" class="btn btn--primary">Design my trip</a>
          <a href="#model" class="btn btn--secondary" data-back-to-pick>Pick places on the model</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ---------- the stage ---------- */
  .world { --stage-h: calc(100svh - var(--header-h)); position: relative; height: calc(var(--stage-h) + 2000vh); background: var(--paper); }
  .w-stage { position: sticky; top: var(--header-h); height: var(--stage-h); min-height: 520px; overflow: hidden; isolation: isolate; background: var(--paper); }
  /* the pool of light on the table */
  .w-stage::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(70% 62% at 52% 60%, #fbfaf8 0%, rgba(251,250,248,.55) 45%, rgba(251,250,248,0) 78%); }
  .w-stage > canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
  .w-stage > canvas.is-dragging { cursor: grabbing; }
  .w-still { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 8% 4% 12% 30%; transition: opacity .6s ease; }
  .w-still img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .world.is-live .w-still { opacity: 0; pointer-events: none; }

  /* layers fade by phase */
  .w-pick, .w-drive, .w-outro { position: absolute; inset: 0; pointer-events: none; transition: opacity .45s ease, visibility 0s linear .45s; }
  .w-pick a, .w-pick button, .w-drive a, .w-drive button, .w-outro a, .w-outro button { pointer-events: auto; }
  .world:not([data-phase="pick"]) .w-pick, .world:not([data-phase="drive"]) .w-drive, .world:not([data-phase="outro"]) .w-outro { opacity: 0; visibility: hidden; }
  .world[data-phase="pick"] .w-pick, .world[data-phase="drive"] .w-drive, .world[data-phase="outro"] .w-outro { opacity: 1; visibility: visible; transition: opacity .45s ease, visibility 0s; }

  /* ---------- pick ---------- */
  .w-intro { position: absolute; left: var(--edge); top: clamp(28px, 6vh, 72px); max-width: min(560px, 44vw); }
  .w-h1 { font-size: var(--t-3xl); line-height: 1.02; letter-spacing: -.025em; font-weight: 520; max-width: 11ch; }
  .w-lead { margin: 22px 0 0; max-width: 38ch; font-size: var(--t-md); line-height: 1.5; color: var(--slate-2); }

  .w-labels { position: absolute; inset: 0; }
  .w-label { position: absolute; left: 0; top: 0; padding: 0; border: 0; background: none; cursor: pointer; will-change: transform; }
  .world:not(.is-live) .w-label { visibility: hidden; }
  .w-label.is-off { visibility: hidden; }
  .w-label-in { position: absolute; left: 0; bottom: 10px; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px 5px 5px;
    border-radius: 12px; background: var(--surface); box-shadow: 0 3px 0 var(--plaster-d), 0 12px 18px -10px rgba(31,29,26,.6); white-space: nowrap;
    font: 600 14px/1 var(--font-ui); color: var(--ink); transition: background .2s, color .2s, transform .35s cubic-bezier(.34, 1.56, .64, 1); }
  .w-label-in::after { content: ''; position: absolute; left: 50%; top: 100%; margin-left: -6px; border: 6px solid transparent; border-top-color: var(--surface); transition: border-color .2s; }
    .w-tick { position: relative; width: 22px; height: 22px; border-radius: 7px; background: var(--paper); box-shadow: inset 0 0 0 1.5px var(--line-3); flex: none; }
  .w-tick::before, .w-tick::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 2px; margin: -1px 0 0 -5px; background: var(--ink); border-radius: 1px; transition: transform .25s ease; }
  .w-tick::after { transform: rotate(90deg); }
  .w-label:hover .w-label-in, .w-label:focus-visible .w-label-in { transform: translateX(-50%) translateY(-3px); }
  .w-label:focus-visible { outline: none; }
  .w-label:focus-visible .w-label-in { outline: 3px solid var(--red); outline-offset: 2px; }
  .w-label[aria-pressed="true"] .w-label-in { background: var(--ink); color: #fff; box-shadow: 0 3px 0 #000, 0 12px 18px -10px rgba(31,29,26,.7); }
  .w-label[aria-pressed="true"] .w-label-in::after { border-top-color: var(--ink); }
    .w-label[aria-pressed="true"] .w-tick { background: var(--red); box-shadow: none; }
  .w-label[aria-pressed="true"] .w-tick::before { width: 5px; margin: 0; transform: translate(-4px, 1px) rotate(45deg); background: #fff; }
  .w-label[aria-pressed="true"] .w-tick::after { width: 9px; margin: 0; transform: translate(-1px, -1px) rotate(-50deg); background: #fff; }
  .is-live .w-labels.is-ready .w-label-in { animation: wPop .6s cubic-bezier(.34, 1.56, .64, 1) both; animation-delay: calc(var(--k, 0) * 60ms); }
  @keyframes wPop { from { opacity: 0; transform: translateX(-50%) translateY(8px) scale(.7); } to { opacity: 1; transform: translateX(-50%); } }

  .w-tray { position: absolute; left: var(--edge); bottom: clamp(20px, 4vh, 40px); display: flex; align-items: center; gap: 14px 22px;
    max-width: min(620px, calc(100% - 2 * var(--gutter))); padding: 14px 14px 14px 20px; background: var(--surface); border-radius: var(--r); box-shadow: var(--plinth-sm); }
  .w-tray-txt { flex: 1 1 auto; min-width: 0; }
  .w-tray .btn { flex: none; }
  .w-tray-k { margin: 0; font: 600 13.5px/1.2 var(--font-ui); color: var(--muted); }
  .w-tray-v { margin: 4px 0 0; font-size: 17px; line-height: 1.35; color: var(--slate-2); }
  .w-tray-v b { color: var(--ink); font-weight: 600; }
  .w-cue { position: absolute; right: var(--edge); bottom: clamp(28px, 4.6vh, 48px); margin: 0; display: flex; align-items: center; gap: 12px; font: 600 15px var(--font-ui); }
  .w-cue-ico { display: inline-flex; width: 42px; height: 42px; border-radius: 13px; background: var(--surface); box-shadow: 0 3px 0 var(--plaster-d); color: var(--red); align-items: center; justify-content: center; animation: wNudge 2.4s ease-in-out infinite; }
  @keyframes wNudge { 0%, 60%, 100% { transform: none; } 30% { transform: translateY(4px); } }
  .w-hint { position: absolute; right: var(--edge); top: clamp(24px, 4vh, 40px); margin: 0; font: 500 13.5px var(--font-ui); color: var(--muted); }
  .world:not(.is-live) .w-hint { display: none; }

  /* ---------- drive ---------- */
  .w-cards { list-style: none; margin: 0; padding: 0; }
  .w-card { position: absolute; left: var(--edge); bottom: clamp(96px, 13vh, 128px); width: min(400px, calc(100% - 2 * var(--gutter)));
    background: var(--surface); border-radius: var(--r); box-shadow: var(--plinth-sm); padding: 10px 10px 20px;
    opacity: 0; visibility: hidden; transform: translate3d(0, 14px, 0);
    transition: opacity .35s ease, transform .55s cubic-bezier(.2, .8, .2, 1), visibility 0s linear .35s; }
  .w-card.is-on { opacity: 1; visibility: visible; transform: none; transition: opacity .35s ease, transform .55s cubic-bezier(.2, .8, .2, 1), visibility 0s; }
  /* the live model is right behind the card, so its photo of the model only shows without WebGL */
  .world:not(.is-flat) .w-card-img { display: none; }
  .w-card-img { aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #fff; }
  .w-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .w-card-place { margin: 12px 10px 4px; display: flex; align-items: center; gap: 9px; font: 600 14px/1 var(--font-ui); color: var(--slate); }
    .w-num { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 8px; background: var(--red); color: #fff; font-size: 13px; box-shadow: 0 2px 0 var(--red-deep); }
  .w-card-h { margin: 10px 10px 8px; font-size: clamp(25px, 2vw, 30px); line-height: 1.1; letter-spacing: -.015em; font-weight: 540; text-wrap: balance; }
  .w-card-p { margin: 0 10px 14px; font-size: 17px; line-height: 1.5; color: var(--slate-2); }
  .w-facts { margin: 0 10px 6px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .w-facts > div { padding: 9px 11px 10px; background: var(--paper); border-radius: 10px; display: flex; flex-direction: column-reverse; }
  .w-facts dt { font: 400 13px/1.3 var(--font-ui); color: var(--muted); }
  .w-facts dd { margin: 0 0 3px; font: 600 18px/1.15 var(--font-ui); letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
  .w-card .lnk { margin-left: 10px; }
  /* a leg reads like a road sign */
  .w-leg { padding: 18px 20px 20px; background: var(--ink); color: #fff; box-shadow: 0 4px 0 #000, 0 22px 30px -18px rgba(31,29,26,.6); }
  .w-leg-route { margin: 0 0 12px; display: flex; align-items: center; gap: 14px; font: 520 24px/1.1 var(--font-serif); letter-spacing: -.01em; }
  .w-leg-line { flex: 1; height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--red) 0 10px, transparent 10px 18px) 0 0 / 18px 4px repeat-x; min-width: 40px; }
  .w-leg-d { margin: 0; font: 400 15.5px/1.4 var(--font-ui); color: #cfcac3; }
  .w-leg-d strong { margin-right: 6px; font: 600 17px var(--font-ui); color: #fff; }
  .w-leg-v { margin: 4px 0 0; font: italic 400 17px/1.4 var(--font-serif); color: #cfcac3; }

  .w-bar { position: absolute; left: 50%; bottom: clamp(18px, 3vh, 30px); transform: translateX(-50%); width: min(760px, calc(100% - 2 * var(--gutter)));
    padding: 8px 10px 6px; background: var(--surface); border-radius: 16px; box-shadow: var(--plinth-sm); }
  .w-bar-track { position: absolute; left: calc(10px + (100% - 20px) / 12); right: calc(10px + (100% - 20px) / 12); top: 25px; height: 4px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .w-bar-track i { display: block; height: 100%; background: var(--red); transform-origin: left; transform: scaleX(var(--fill, 0)); }
  .w-bar ol { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); }
  .w-dot { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 4px 0; border: 0; background: none; cursor: pointer; font: 600 13px/1 var(--font-ui); color: var(--slate); min-height: 44px; }
  .w-dot-n { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 9px; background: var(--surface); box-shadow: inset 0 0 0 1.5px var(--line-3); font-size: 12.5px; color: var(--slate); transition: all .25s ease; }
  .w-dot.is-done .w-dot-n { background: var(--ink); color: #fff; box-shadow: none; }
  .w-dot[aria-current="true"] { color: var(--ink); }
  .w-dot[aria-current="true"] .w-dot-n { background: var(--red); color: #fff; box-shadow: 0 2px 0 #9e1a28; transform: scale(1.12); }
  .w-dot:hover { color: var(--ink); }

  /* ---------- outro ---------- */
  .w-outro-card { position: absolute; left: var(--edge); top: 50%; transform: translateY(-50%); width: min(520px, calc(100% - 2 * var(--gutter))); padding: 28px 30px 30px; }
  .w-outro-h { font-size: clamp(32px, 3.2vw, 48px); line-height: 1.06; letter-spacing: -.02em; font-weight: 520; text-wrap: balance; }
  .w-outro-card p { margin: 16px 0 0; font-size: 18px; line-height: 1.55; color: var(--slate-2); }
  .w-outro-cta { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 12px; }

  /* ---------- phones ---------- */
  @media (max-width: 760px) {
    .w-intro { top: 18px; max-width: none; right: var(--gutter); }
    .w-h1 { font-size: clamp(36px, 10.5vw, 48px); max-width: 11ch; }
    .w-lead { margin-top: 10px; font-size: 16px; max-width: 34ch; }
    .w-hint { display: none; }
    .w-cue { display: none; }
    /* labels become a row of chips above the tray */
    .w-labels { position: absolute; inset: auto 0 calc(clamp(20px, 4vh, 40px) + 96px) 0; display: flex; gap: 8px; overflow-x: auto; padding: 4px var(--gutter) 10px; scrollbar-width: none; }
    .w-labels::-webkit-scrollbar { display: none; }
    .w-label { position: static; transform: none !important; flex: none; }
    .world .w-label, .w-label.is-off { visibility: visible; }
    .w-label-in { position: static; transform: none; }
    .w-label-in::after { display: none; }
    .w-label:hover .w-label-in { transform: none; }
    .is-live .w-labels.is-ready .w-label-in { animation: none; }
    .w-tray { left: var(--gutter); right: var(--gutter); max-width: none; padding: 12px 12px 12px 16px; }
    .w-tray .btn { min-height: 46px; padding: 0 16px; font-size: 16px; }
    .w-tray-v { font-size: 15px; }
    .w-card { left: var(--gutter); right: var(--gutter); width: auto; bottom: 92px; padding: 8px 8px 14px; }
    .w-card-img { display: none; }
    .w-card-place { margin-top: 10px; }
    .w-card-p { font-size: 15px; }
    .w-card-h { font-size: 23px; }
    .w-bar { padding: 6px 4px 4px; }
    .w-dot-t { display: none; }
    .w-bar-track { top: 21px; }
    .w-dot { min-height: 40px; }
    .w-outro-card { top: auto; bottom: 20px; transform: none; left: var(--gutter); padding: 22px 20px 22px; }
    .w-still { padding: 30% 0 40%; }
  }

  /* ---------- no WebGL: a still render, chips, and the drive as a plain list ---------- */
  .world.is-flat { height: auto; }
  .world.is-flat .w-stage { position: relative; top: 0; height: auto; min-height: 0; overflow: visible; padding: 0 0 40px; }
  .world.is-flat .w-stage > canvas, .world.is-flat .w-hint, .world.is-flat .w-cue, .world.is-flat .w-bar { display: none; }
  .world.is-flat .w-still { position: relative; inset: auto; padding: 0 var(--gutter); height: min(60vh, 560px); }
  .world.is-flat .w-pick, .world.is-flat .w-drive, .world.is-flat .w-outro { position: relative; inset: auto; opacity: 1; visibility: visible; pointer-events: auto; }
  .world.is-flat .w-intro { position: relative; left: auto; top: auto; padding: 32px var(--edge) 0; max-width: none; }
  .world.is-flat .w-labels { position: relative; inset: auto; display: flex; flex-wrap: wrap; gap: 8px; padding: 20px var(--edge); }
  .world.is-flat .w-label { position: static; visibility: visible; transform: none !important; }
  .world.is-flat .w-label-in { position: static; transform: none; }
  .world.is-flat .w-label-in::after { display: none; }
  .world.is-flat .w-tray { position: relative; left: auto; bottom: auto; margin: 0 var(--edge); }
  .world.is-flat .w-cards { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); padding: 56px var(--edge) 0; }
  .world.is-flat .w-card { position: relative; left: auto; bottom: auto; width: auto; opacity: 1; visibility: visible; transform: none; }
  .world.is-flat .w-leg { display: none; }
  .world.is-flat .w-outro-card { position: relative; left: auto; top: auto; transform: none; margin: 48px var(--edge) 0; }
  .world.is-flat .w-outro [data-back-to-pick] { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .w-cue-ico { animation: none; }
    .is-live .w-labels.is-ready .w-label-in { animation: none; }
  }
</style>
