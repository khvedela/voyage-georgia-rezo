---
/**
 * A destination as a piece of the model: its close-up render on a small plinth, the name in Latin and Georgian,
 * and one line on why to go. Falls back to the route map for a region the model does not cover.
 */
import type { Localized } from '../i18n/content';
import { getLang, l, useT } from '../i18n';
import { Image } from 'astro:assets';
import RouteMap from './RouteMap.astro';
import { modelView } from '../data/model';
interface Props { entry: Localized<'destinations'>; level?: 2 | 3 }
const { entry, level = 3 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const d = entry.data;
const lang = getLang(Astro);
const t = useT(lang);
const view = modelView(t, entry.slug);
---
<article class="card card--stretched dcard">
  <div class="dcard-img">
    {view
      ? <Image src={view.src} alt={view.alt} widths={[420, 640, 840]} sizes="(min-width: 1200px) 340px, (min-width: 700px) 45vw, 100vw" class="zoom" loading="lazy" decoding="async" />
      : <RouteMap id={d.map} class="zoom" />}
  </div>
  <H class="card-title dcard-t"><a href={l(lang, `/destinations/${entry.slug}`)} class="stretch">{d.name}</a></H>
  <p class="card-eyebrow dcard-e">{d.eyebrow}</p>
  <p class="card-text">{d.cardText}</p>
  <a href={l(lang, '/design-my-trip')} class="lnk dcard-add">{t.common.cards.addToTrip}</a>
</article>
<style>
  .dcard-img { position: relative; aspect-ratio: 7 / 5; border-radius: 12px; overflow: hidden; background: #fff; }
  .dcard-img :global(img), .dcard-img :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .dcard-t { margin-top: 18px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .dcard-t a { text-decoration: none; }
  .dcard-e { margin-top: 0; margin-bottom: 8px; }
  .dcard-add { position: relative; z-index: 1; margin-top: auto; }
</style>
