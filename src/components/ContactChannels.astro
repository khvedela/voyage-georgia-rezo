---
import { site, whatsappLink, mailtoLink } from '../config/site';
import { fmt, getLang, useT } from '../i18n';
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const t = useT(getLang(Astro));
const wa = whatsappLink();
const mail = mailtoLink(t.common.channels.mailSubject);
const items = [
  wa && { href: wa, label: t.common.channels.whatsapp },
  site.contact.messenger && { href: site.contact.messenger, label: t.common.channels.messenger },
  mail && { href: mail, label: fmt(t.common.channels.email, { address: site.contact.email ?? '' }) },
].filter(Boolean) as { href: string; label: string }[];
---
{items.length > 0 && (
  <div style="display:flex;flex-wrap:wrap;gap:10px">
    {items.map((i) => (
      <a href={i.href} rel="noopener" class:list={['btn', 'btn--sm', dark ? 'btn--ghost-light' : 'btn--secondary']}>{i.label}</a>
    ))}
  </div>
)}
