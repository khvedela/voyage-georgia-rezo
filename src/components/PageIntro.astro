---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';
import { fmt, formatDate, getLang, useT } from '../i18n';
interface Props {
  eyebrow?: string;
  title: string;
  summary: string;
  crumbs: Crumb[];
  updated?: Date | string;
  /** Show "Prepared by Voyage Georgia Rezo". Off for utility pages. */
  byline?: boolean;
}
const { eyebrow, title, summary, crumbs, updated, byline = true } = Astro.props;
const d = updated ? new Date(updated) : undefined;
const hasAside = Astro.slots.has('aside');
const lang = getLang(Astro);
const t = useT(lang);
const date = d && formatDate(lang, d);
const [updBefore, updAfter = ''] = t.common.intro.updated.split('{date}');
---
<Breadcrumbs items={crumbs} />
<header class:list={['intro', hasAside && 'intro--aside']}>
  <div class="wrap">
    <div class="intro-main">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="h-lg intro-h">{title}</h1>
    <p class="answer">{summary}</p>
    {(byline || d) && (
      <p class="meta intro-meta">
        {byline && <span>{fmt(t.common.intro.by, { name: 'Voyage Georgia Rezo' })}</span>}
        {byline && d && <span aria-hidden="true"> · </span>}
        {d && <span>{updBefore}<time datetime={d.toISOString().slice(0, 10)}>{date}</time>{updAfter}</span>}
      </p>
    )}
    <slot />
    </div>
    {hasAside && <div class="intro-aside"><slot name="aside" /></div>}
  </div>
</header>
<style>
  .intro { padding: clamp(28px, 4vw, 56px) var(--edge) clamp(32px, 4vw, 56px); }
  .intro .wrap { max-width: none; }
  .intro-h { max-width: 20ch; margin-bottom: 22px; font-size: clamp(38px, 4.8vw, 70px); }
  .intro-meta { margin: 18px 0 0; }
  /* With an aside (a destination's piece of the model), the text and the model sit side by side. */
  .intro--aside .wrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: center; }
  @media (min-width: 1000px) { .intro--aside .wrap { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(40px, 5vw, 88px); } }
</style>
