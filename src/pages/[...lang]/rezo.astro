---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import MeetRezo from '../../components/home/MeetRezo.astro';
import CtaBand from '../../components/CtaBand.astro';
import { steps } from '../../data/home';
import { pageByPath } from '../../data/pages';
import { webPage, breadcrumbWithId, ids } from '../../lib/schema';
import { getLang, langPaths, useT } from '../../i18n';

export const getStaticPaths = () => langPaths();
const lang = getLang(Astro);
const t = useT(lang);
const c = t.pages.rezo;
const page = pageByPath(t, '/rezo');
const crumbs = [{ name: t.common.nav.home, path: '/' }, { name: page.nav, path: '/rezo' }];
const graph = [
  webPage({ lang, path: page.path, name: page.title, description: page.description, type: 'ProfilePage', crumbs, dateModified: page.updated, about: { '@id': ids.rezo }, mainEntity: { '@id': ids.rezo } }),
  breadcrumbWithId(lang, page.path, crumbs),
];
---
<Base title={page.title} description={page.description} path={page.path} ogSlug={page.slug} graph={graph} modified={page.updated}>
  <PageIntro eyebrow={c.eyebrow} title={c.title} summary={c.summary} crumbs={crumbs} updated={page.updated} byline={false} />

  <MeetRezo link={false} />

  <section class="section" aria-labelledby="how-h">
    <div class="wrap">
      <h2 id="how-h" class="h-md" style="margin-bottom:12px;max-width:720px">{c.howTitle}</h2>
      <p class="body-lg" style="margin:0;max-width:620px">{c.howText}</p>
      <ol class="how">
        {steps(t).map((s) => (
          <li><span class="how-n">{s.n}</span><h3 class="disp">{s.title}</h3><p>{s.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="tech-h">
    <div class="wrap" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(340px,100%),1fr));gap:40px 72px">
      <div>
        <p class="eyebrow" style="color:#ff6b77">{c.techEyebrow}</p>
        <h2 id="tech-h" class="h-sm" style="margin-bottom:20px">{c.techTitle}</h2>
        <p style="margin:0;font-size:16.5px;color:#D6DFE4" set:html={c.techHtml} />
      </div>
      <ul style="margin:0;padding-left:20px;font-size:16.5px;color:#D6DFE4;display:flex;flex-direction:column;gap:10px;align-self:end">
        {c.techRules.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <CtaBand title={c.ctaTitle} />
</Base>
<style>
  .how { list-style: none; margin: clamp(36px, 5vw, 64px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 36px 32px; }
  .how li { border-top: 2px solid var(--ink); padding-top: 20px; }
  .how-n { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; padding: 0 10px; border-radius: 999px; background: var(--red); color: #fff; font-family: var(--font-ui); font-weight: 600; font-size: 14px; }
  .how h3 { margin: 12px 0 8px; font-size: 23px; line-height: 1.2; letter-spacing: -.02em; }
  .how p { margin: 0; color: var(--slate); font-size: 16.5px; }
</style>
