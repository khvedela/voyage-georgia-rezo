---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Localized from "../../../components/Localized.astro";
import PageIntro from '../../../components/PageIntro.astro';
import PhotoFigure from '../../../components/PhotoFigure.astro';
import DestinationCard from '../../../components/DestinationCard.astro';
import Faq from '../../../components/Faq.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { webPage, article, faqPage, breadcrumbWithId } from '../../../lib/schema';
import { absoluteUrl } from '../../../config/site';
import { defaultLocale, fmt, getLang, l, locales, useT } from '../../../i18n';
import { getLocalized, slugs } from '../../../i18n/content';

export async function getStaticPaths() {
  const all = await slugs('guides');
  return locales.flatMap((lang) => all.map((slug) => ({ params: { lang: lang === defaultLocale ? undefined : lang, slug } })));
}
const lang = getLang(Astro);
const t = useT(lang);
const c = t.pages.guide;
const all = await getLocalized('guides', lang);
const dest = await getLocalized('destinations', lang);
const entry = all.find((e) => e.slug === Astro.params.slug)!;
const d = entry.data;
const { Content, headings } = await render(entry);
const path = `/guides/${entry.slug}`;
const crumbs = [{ name: t.common.nav.home, path: '/' }, { name: t.pages.meta.guides.nav, path: '/guides' }, { name: d.title, path }];
const pub = d.published.toISOString().slice(0, 10);
const mod = d.updated.toISOString().slice(0, 10);
const places = d.destinations.map((id) => dest.find((x) => x.slug === id)).filter((x) => x !== undefined);
const others = all.filter((g) => g.slug !== entry.slug);
const toc = headings.filter((h) => h.depth === 2);
const graph = [
  webPage({ lang, path, name: d.seoTitle, description: d.description, type: 'WebPage', crumbs, datePublished: pub, dateModified: mod, about: { '@id': `${absoluteUrl(l(lang, path))}#article` } }),
  breadcrumbWithId(lang, path, crumbs),
  article({ lang, path, headline: d.title, description: d.description, published: pub, modified: mod, keywords: d.keywords }),
  ...(d.faqs.length ? [faqPage(lang, path, d.faqs)] : []),
];
---
<Base title={d.seoTitle} description={d.description} path={path} type="article" published={pub} modified={mod} ogSlug={`guides-${entry.slug}`} graph={graph}>
  <PageIntro eyebrow={fmt(c.eyebrow, { n: d.readingMinutes })} title={d.title} summary={d.summary} crumbs={crumbs} updated={d.updated} />

  <section class="section" style="padding-top:0">
    <div class="wrap gg">
      <article class="prose"><Localized><Content /></Localized></article>
      <aside class="gaside" aria-label={c.asideLabel}>
        {d.photo && <PhotoFigure id={d.photo} ratio="3 / 2" eager />}
        {toc.length > 1 && (
          <nav aria-label={c.contents} class="toc">
            <p class="eyebrow eyebrow--slate" style="margin-bottom:10px">{c.onThisPage}</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>
    </div>
  </section>

  {d.faqs.length > 0 && (
    <section class="section section--mist" aria-labelledby="faq-h">
      <div class="wrap--narrow">
        <h2 id="faq-h" class="h-sm" style="margin-bottom:28px">{c.faqTitle}</h2>
        <Faq items={d.faqs} />
      </div>
    </section>
  )}

  {places.length > 0 && (
    <section class="section" aria-labelledby="places-h">
      <div class="wrap">
        <h2 id="places-h" class="h-sm" style="margin-bottom:28px">{c.placesTitle}</h2>
        <div class="grid-auto" style="--min:250px;gap:32px 24px">{places.slice(0, 4).map((p) => <DestinationCard entry={p} />)}</div>
      </div>
    </section>
  )}

  <section class="section section--mist section--tight" aria-labelledby="more-h">
    <div class="wrap--narrow">
      <h2 id="more-h" class="h-sm" style="margin-bottom:18px">{c.moreTitle}</h2>
      <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px">
        {others.map((g) => <li><a class="lnk" href={l(lang, `/guides/${g.slug}`)}>{g.data.title}</a></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
<style>
  .gg { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; }
  @media (min-width: 1000px) { .gg { grid-template-columns: minmax(0, 1fr) 380px; gap: 72px; align-items: start; } .gaside { position: sticky; top: 96px; } }
  .gaside { display: flex; flex-direction: column; gap: 28px; }
  .toc ol { margin: 0; padding: 0; list-style: none; border-top: 1.5px solid var(--ink); }
  .toc li { border-bottom: 1px solid var(--line); }
  .toc a { display: block; padding: 10px 0; text-decoration: none; color: var(--slate-2); font-size: 15.5px; }
  .toc a:hover { color: var(--red); }
</style>
