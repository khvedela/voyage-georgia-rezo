---
import Dash from '../../../layouts/Dash.astro';
import { fmt, getLang, l, langPaths, useT } from '../../../i18n';

export const getStaticPaths = () => langPaths();
const lang = getLang(Astro);
const s = useT(lang).studio;
const t = s.today;
const { people, interests } = s.dash;
---
<Dash title={t.title} path="/studio" nav>
  <header style="padding:18px 20px 10px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
    <div>
      <p class="d-sub" style="font-size:14px">{t.greeting}</p>
      <h1 class="disp" style="margin:0;font-weight:400;font-size:38px;line-height:1.05;letter-spacing:-.02em">{t.title}</h1>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
      <span class="d-sync"><i aria-hidden="true"></i>{t.synced}</span>
      <span style="font-size:11.5px;color:var(--slate)">{t.sample}</span>
    </div>
  </header>
  <div class="d-main" style="padding:6px 20px 20px;gap:22px">
    <section aria-labelledby="needs">
      <h2 id="needs" style="margin:0 0 10px;font-family:var(--font-body);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--red);font-weight:600">{fmt(t.needsYou, { n: 4 })}</h2>
      <div style="display:flex;flex-direction:column;gap:12px">
        <a href={l(lang, '/studio/builder')} class="d-card d-card--dark">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span style="padding:2px 10px;border-radius:999px;background:var(--red);font-size:12px;font-weight:600">{t.change.tag}</span><span style="font-size:12.5px;color:var(--line-3)">{t.change.ago}</span></div>
          <h3>{people.annaDaniel}</h3>
          <p style="margin:0;font-size:15.5px;color:#C2CED5">{t.change.quote}</p>
          <p style="margin:12px 0 0;font-size:15px;font-weight:600;color:#ff6b77">{t.change.action}</p>
        </a>
        <a href={l(lang, '/studio/inquiry')} class="d-card d-card--hot">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span style="display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--red)"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--red)"></span>{t.leila.tag}</span><span style="font-size:12.5px;color:var(--slate)">{t.leila.ago}</span></div>
          <h3>{people.leila}</h3>
          <p style="margin:0;font-size:15px;color:var(--slate)">{t.leila.summary}</p>
          <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:6px"><span class="d-tag">{interests.mountains}</span><span class="d-tag">{interests.wine}</span><span class="d-tag">{interests.churches}</span><span class="d-tag">{interests.blackSea}</span></div>
        </a>
        <a href={l(lang, '/studio/inquiry')} class="d-card">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span style="display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--red)"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--red)"></span>{t.tomas.tag}</span><span style="font-size:12.5px;color:var(--slate)">{t.tomas.ago}</span></div>
          <h3>{people.tomas}</h3>
          <p style="margin:0;font-size:15px;color:var(--slate)">{t.tomas.summary}</p>
          <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:6px"><span class="d-tag d-tag--ink">{t.tomas.access}</span><span class="d-tag">{interests.history}</span></div>
        </a>
        <a href={l(lang, '/studio/inquiry')} class="d-card">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span style="font-size:12.5px;font-weight:600;color:var(--slate)">{t.james.tag}</span><span style="font-size:12.5px;color:var(--slate)">{t.james.ago}</span></div>
          <h3>{people.james}</h3>
          <p style="margin:0;font-size:15px;color:var(--slate)">{t.james.summary}</p>
        </a>
      </div>
    </section>
    <section aria-labelledby="road">
      <h2 id="road" style="margin:0 0 10px;font-family:var(--font-body);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--red);font-weight:600">{t.onRoad.title}</h2>
      <div style="padding:16px;border-radius:14px;background:var(--mist)">
        <div style="display:flex;justify-content:space-between;gap:10px;align-items:baseline"><strong class="disp" style="font-weight:500;font-size:20px">{people.karlInes}</strong><span style="font-size:14px;color:var(--slate)">{t.onRoad.progress}</span></div>
        <p style="margin:4px 0 0;font-size:15px;color:var(--slate-2)">{t.onRoad.tomorrow}</p>
        <p style="margin:2px 0 0;font-size:14px;color:var(--slate)">{t.onRoad.crew}</p>
      </div>
    </section>
  </div>
</Dash>
