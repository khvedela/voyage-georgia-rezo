---
import Base from '../../../layouts/Base.astro';
import PageIntro from '../../../components/PageIntro.astro';
import JourneyCard from '../../../components/JourneyCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { pageByPath } from '../../../data/pages';
import { webPage, itemList, breadcrumbWithId } from '../../../lib/schema';
import { getLang, langPaths, useT } from '../../../i18n';
import { getLocalized } from '../../../i18n/content';

export const getStaticPaths = () => langPaths();
const lang = getLang(Astro);
const t = useT(lang);
const c = t.pages.journeys;
const page = pageByPath(t, '/journeys');
const items = await getLocalized('journeys', lang);
const crumbs = [{ name: t.common.nav.home, path: '/' }, { name: page.nav, path: '/journeys' }];
const graph = [
  webPage({ lang, path: page.path, name: page.title, description: page.description, type: 'CollectionPage', crumbs, dateModified: page.updated }),
  breadcrumbWithId(lang, page.path, crumbs),
  itemList(lang, c.listName, items.map((j) => ({ name: j.data.title, path: `/journeys/${j.slug}` }))),
];
---
<Base title={page.title} description={page.description} path={page.path} ogSlug={page.slug} graph={graph} modified={page.updated}>
  <PageIntro eyebrow={c.eyebrow} title={c.title} summary={c.summary} crumbs={crumbs} updated={page.updated} />
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="grid-auto" style="--min:330px">
        {items.map((j) => <JourneyCard entry={j} level={2} />)}
      </div>
    </div>
  </section>
  <CtaBand title={c.ctaTitle} text={c.ctaText} />
</Base>
