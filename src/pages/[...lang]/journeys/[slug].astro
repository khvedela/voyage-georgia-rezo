---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Localized from "../../../components/Localized.astro";
import PageIntro from '../../../components/PageIntro.astro';
import PhotoFigure from '../../../components/PhotoFigure.astro';
import RouteMap from '../../../components/RouteMap.astro';
import Faq from '../../../components/Faq.astro';
import CtaBand from '../../../components/CtaBand.astro';
import JourneyCard from '../../../components/JourneyCard.astro';
import { webPage, touristTrip, faqPage, breadcrumbWithId } from '../../../lib/schema';
import { absoluteUrl } from '../../../config/site';
import { defaultLocale, fmt, getLang, l, locales, plural, useT } from '../../../i18n';
import { getLocalized, slugs } from '../../../i18n/content';

export async function getStaticPaths() {
  const all = await slugs('journeys');
  return locales.flatMap((lang) => all.map((slug) => ({ params: { lang: lang === defaultLocale ? undefined : lang, slug } })));
}
const lang = getLang(Astro);
const t = useT(lang);
const c = t.pages.journey;
const all = await getLocalized('journeys', lang);
const entry = all.find((e) => e.slug === Astro.params.slug)!;
const d = entry.data;
const { Content } = await render(entry);
const path = `/journeys/${entry.slug}`;
const crumbs = [{ name: t.common.nav.home, path: '/' }, { name: t.pages.meta.journeys.nav, path: '/journeys' }, { name: d.title, path }];
const others = all.filter((x) => x.slug !== entry.slug);
const iso = d.updated.toISOString().slice(0, 10);
const graph = [
  webPage({ lang, path, name: d.seoTitle, description: d.description, type: 'WebPage', crumbs, dateModified: iso, about: { '@id': `${absoluteUrl(l(lang, path))}#trip` } }),
  breadcrumbWithId(lang, path, crumbs),
  touristTrip({
    lang, path, name: fmt(c.tripName, { title: d.title, days: d.days }), description: d.summary, days: d.days,
    stops: d.stops.map((s) => ({ name: s.name, description: `${s.nights}. ${s.note}`, path: s.destination ? `/destinations/${s.destination}` : undefined })),
  }),
  ...(d.faqs.length ? [faqPage(lang, path, d.faqs)] : []),
];
---
<Base title={d.seoTitle} description={d.description} path={path} ogSlug={`journeys-${entry.slug}`} graph={graph} modified={iso}>
  <PageIntro eyebrow={d.meta} title={d.title} summary={d.summary} crumbs={crumbs} updated={d.updated}>
    <p style="margin:26px 0 0;display:flex;flex-wrap:wrap;gap:10px">
      <span class="pill">{plural(lang, d.days, t.common.units.days)}</span><span class="pill">{d.pace}</span><span class="pill">{fmt(c.best, { months: d.bestMonths.split('.')[0] })}</span>
    </p>
  </PageIntro>

  <section class="section" style="padding-top:0">
    <div class="wrap jgrid">
      <div>
        <h2 class="h-sm" style="margin-bottom:20px">{c.nightsTitle}</h2>
        <ol class="stops">
          {d.stops.map((s, i) => (
            <li>
              <span class="stop-n" aria-hidden="true">{i + 1}</span>
              <div>
                <p class="stop-h">
                  {s.destination ? <a href={l(lang, `/destinations/${s.destination}`)}>{s.name}</a> : s.name}
                  <span class="stop-nights">{s.nights}</span>
                </p>
                <p class="stop-t">{s.note}</p>
              </div>
            </li>
          ))}
        </ol>
        <article class="prose" style="margin-top:48px"><Localized><Content /></Localized></article>
      </div>
      <aside class="jaside" aria-label={c.mapLabel}>
        <div class="mapcard"><RouteMap id={d.map} /></div>
        <PhotoFigure id={d.photo} ratio="3 / 2" />
        <a href={l(lang, `/design-my-trip?sample=${d.builderSample}`)} class="btn btn--primary btn--sm">{c.start}</a>
      </aside>
    </div>
  </section>

  {d.faqs.length > 0 && (
    <section class="section section--mist" aria-labelledby="faq-h">
      <div class="wrap--narrow">
        <h2 id="faq-h" class="h-sm" style="margin-bottom:28px">{c.faqTitle}</h2>
        <Faq items={d.faqs} />
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="more-h">
    <div class="wrap">
      <h2 id="more-h" class="h-sm" style="margin-bottom:28px">{c.othersTitle}</h2>
      <div class="grid-auto" style="--min:330px">{others.map((j) => <JourneyCard entry={j} />)}</div>
    </div>
  </section>

  <CtaBand sample={d.builderSample} title={c.ctaTitle} text={c.ctaText} />
</Base>
<style>
  .jgrid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; }
  @media (min-width: 1000px) { .jgrid { grid-template-columns: minmax(0, 1fr) 520px; gap: 64px; align-items: start; } .jaside { position: sticky; top: 96px; } }
  .jaside { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .jaside > * { width: 100%; }
  .jaside .btn { width: auto; }
  .mapcard { border: 1px solid var(--line); border-radius: 14px; padding: 8px; background: #fff; }
  .mapcard svg { width: 100%; height: auto; display: block; border-radius: 8px; background: var(--mist); }
  .stops { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .stops li { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 14px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .stop-n { width: 30px; height: 30px; border-radius: 50%; background: var(--red); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-ui); font-weight: 600; font-size: 14px; }
  .stop-h { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: -.015em; }
  .stop-h a { color: var(--ink); text-underline-offset: 4px; text-decoration-color: var(--line-3); }
  .stop-h a:hover { color: var(--red); }
  .stop-nights { font-family: var(--font-body); font-weight: 500; font-size: 14px; color: var(--slate); letter-spacing: 0; }
  .stop-t { margin: 4px 0 0; color: var(--slate); font-size: 16px; }
</style>
