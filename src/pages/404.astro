---
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
---
<Base title="Page not found" description="That page does not exist. Start from the homepage or design your trip." path="/404" noindex>
  <section class="section" style="min-height:60vh;display:flex;align-items:center">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="h-lg" style="margin-bottom:18px">This road doesn’t go anywhere.</h1>
      <p class="body-lg" style="margin:0 0 28px;max-width:520px">The page you were looking for isn’t here. Try one of these instead.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="/" class="btn btn--primary">Back to home <ArrowIcon /></a>
        <a href="/destinations" class="btn btn--secondary">Destinations</a>
        <a href="/design-my-trip" class="btn btn--secondary">Design my trip</a>
      </div>
    </div>
  </section>
</Base>
