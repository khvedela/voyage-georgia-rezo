---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import JourneyScene from '../components/home/JourneyScene.astro';
import Specialisms from '../components/home/Specialisms.astro';
import MeetRezo from '../components/home/MeetRezo.astro';
import DestinationCard from '../components/DestinationCard.astro';
import JourneyCard from '../components/JourneyCard.astro';
import VehicleCards from '../components/VehicleCards.astro';
import ContactCta from '../components/ContactCta.astro';
import Faq from '../components/Faq.astro';
import { steps, trust } from '../data/home';
import { homeFaqs } from '../data/faqs';
import { pageByPath } from '../data/pages';
import { webPage, faqPage, itemList } from '../lib/schema';
import { site } from '../config/site';

const page = pageByPath('/');
const destinations = (await getCollection('destinations')).sort((a, b) => a.data.order - b.data.order);
const journeys = (await getCollection('journeys')).sort((a, b) => a.data.order - b.data.order);
const featured = ['kazbegi', 'kakheti', 'svaneti', 'batumi-adjara'].map((id) => destinations.find((d) => d.id === id)!);
const more = destinations.filter((d) => !featured.includes(d));

const graph = [
  webPage({ path: '/', name: page.title, description: page.description, type: 'WebPage', dateModified: page.updated }),
  faqPage('/', homeFaqs),
  itemList('Example journeys', journeys.map((j) => ({ name: j.data.title, path: `/journeys/${j.id}` }))),
  itemList('Destinations', destinations.map((d) => ({ name: d.data.name, path: `/destinations/${d.id}` }))),
];
---
<Base title={page.title} description={page.description} path="/" ogSlug="home" graph={graph} modified={page.updated}>
  <JourneyScene />

  <section class="trust" aria-label="Why Voyage Georgia Rezo">
    <ul>
      {trust.map((t) => <li><strong>{t.strong}</strong>{t.text}</li>)}
    </ul>
  </section>

  <section id="how" class="section" aria-labelledby="how-h">
    <div class="wrap">
      <div class="split">
        <h2 id="how-h" class="h-lg" style="max-width:720px">Not a package.<br /><span class="red">A conversation.</span></h2>
        <p class="body-lg" style="margin:0;max-width:430px">Most agencies hand you a brochure itinerary. Rezo starts with a blank map and your own words, then plans the journey around you.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <div class="step-n">{s.n}</div>
            <h3 class="disp">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
      <p class="callout"><strong>Technology helps us keep track. It never replaces Rezo.</strong> Every itinerary and every price is reviewed and approved by him before you see it, and nothing is final until he says so.</p>
    </div>
  </section>

  <section id="where" class="section" style="padding-top:0" aria-labelledby="where-h">
    <div class="wrap">
      <h2 id="where-h" class="h-lg" style="margin-bottom:12px">Where do you want to wake up?</h2>
      <p class="body-lg" style="margin:0 0 clamp(32px,4vw,52px);max-width:620px">You don’t need to know the map. Pick what moves you and Rezo connects the dots.</p>
      <div class="grid-auto" style="--min:250px;gap:32px 24px">
        {featured.map((d) => <DestinationCard entry={d} />)}
      </div>
      <p class="note" style="margin:36px 0 0;max-width:900px;font-size:15.5px"><strong style="color:var(--ink);font-weight:600">Also on Rezo’s map:</strong>
        {more.map((d, i) => <><a href={`/destinations/${d.id}`} class="inline-lnk">{d.data.name}</a>{i < more.length - 1 ? ' · ' : ' · '}</>)}
        Mtskheta · Borjomi · Vardzia · Racha · David Gareja · Martvili Canyon — and the small roads between them. <a href="/destinations" class="inline-lnk">All destinations →</a></p>
    </div>
  </section>

  <section id="journeys" class="section section--mist" aria-labelledby="journeys-h">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(32px,4vw,52px)">
        <h2 id="journeys-h" class="h-lg" style="max-width:700px">Journeys Rezo <span class="red">might plan</span></h2>
        <p class="body-lg" style="margin:0;max-width:440px;font-size:16.5px">Starting points, never fixed packages. Route, length, pace and price are always set for you.</p>
      </div>
      <div class="grid-auto" style="--min:330px">
        {journeys.map((j) => <JourneyCard entry={j} />)}
      </div>
    </div>
  </section>

  <MeetRezo />

  <section id="fleet" class="section" aria-labelledby="fleet-h">
    <div class="wrap">
      <h2 id="fleet-h" class="h-lg" style="margin-bottom:12px">Five vehicles. <span class="red">One for every road.</span></h2>
      <p class="body-lg" style="margin:0 0 clamp(32px,4vw,52px);max-width:620px">The vehicle is chosen after the route — never the other way round.</p>
      <VehicleCards />
      <p style="margin:32px 0 0"><a href="/vehicles" class="lnk">About the vehicles <span aria-hidden="true" class="red">→</span></a></p>
    </div>
  </section>

  <Specialisms />

  {site.showPlaceholders && (
    <section class="section section--mist section--tight" aria-label="Testimonials (placeholder)">
      <div class="wrap">
        <h2 class="h-md" style="margin-bottom:12px">In travellers’ words</h2>
        <p class="body-lg" style="margin:0 0 36px;max-width:640px;font-size:16.5px">Only genuine testimonials, shown with permission. Nothing appears here until Rezo has real ones to share.</p>
        <div class="grid-auto" style="--min:300px;gap:20px">
          {['photo with permission', 'trip dates', 'link to original post'].map((hint) => (
            <figure class="slot" style="margin:0;border-radius:14px;background:#fff;padding:28px 26px;min-height:190px;align-items:stretch;justify-content:space-between;text-align:left;gap:20px">
              <blockquote class="disp" style="margin:0;font-weight:500;font-size:21px;line-height:1.35;color:var(--slate)">[A real traveller’s quote about their journey.]</blockquote>
              <figcaption style="font-size:14.5px">[Name · country · trip] — {hint}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <ContactCta />

  <section id="faq" class="section" aria-labelledby="faq-h">
    <div class="wrap--narrow">
      <h2 id="faq-h" class="h-md" style="margin-bottom:36px">Questions travellers ask</h2>
      <Faq items={homeFaqs} />
      <p style="margin:28px 0 0"><a href="/faq" class="lnk">More questions and answers <span aria-hidden="true" class="red">→</span></a></p>
    </div>
  </section>

  <script>
    import '../scripts/home-journey';
  </script>
</Base>

<style>
  .trust { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #fff; }
  .trust ul { list-style: none; margin: 0; padding: 26px var(--edge); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: 18px 32px; font-size: 15px; color: var(--slate); }
  .trust strong { display: block; font-family: var(--font-display); font-weight: 600; font-size: 24px; letter-spacing: -.02em; color: var(--ink); }
  .steps { list-style: none; margin: clamp(40px, 6vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 36px 32px; }
  .steps li { border-top: 2px solid var(--ink); padding-top: 20px; }
  .step-n { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; padding: 0 10px; border-radius: 999px; background: var(--red); color: #fff; font-family: var(--font-display); font-weight: 600; font-size: 14px; letter-spacing: .04em; }
  .steps h3 { margin: 12px 0 8px; font-size: 23px; line-height: 1.2; letter-spacing: -.02em; }
  .steps p { margin: 0; color: var(--slate); font-size: 16.5px; }
  .callout { margin: clamp(36px, 5vw, 64px) 0 0; padding: 22px 26px 22px 24px; background: var(--mist); border-left: 3px solid var(--red); border-radius: 0 12px 12px 0; max-width: 860px; font-size: 16.5px; color: var(--slate-2); }
  .callout strong { font-weight: 600; }
  .inline-lnk { color: var(--ink); text-underline-offset: 3px; text-decoration-color: var(--line-3); }
  .inline-lnk:hover { color: var(--red); text-decoration-color: var(--red); }
</style>
