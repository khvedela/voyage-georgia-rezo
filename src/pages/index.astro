---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import World from '../components/home/World.astro';
import MeetRezo from '../components/home/MeetRezo.astro';
import DestinationCard from '../components/DestinationCard.astro';
import JourneyCard from '../components/JourneyCard.astro';
import VehicleCards from '../components/VehicleCards.astro';
import ContactCta from '../components/ContactCta.astro';
import Faq from '../components/Faq.astro';
import { steps } from '../data/home';
import { homeFaqs } from '../data/faqs';
import { pageByPath } from '../data/pages';
import { webPage, faqPage, itemList } from '../lib/schema';
import { site } from '../config/site';

const page = pageByPath('/');
const destinations = (await getCollection('destinations')).sort((a, b) => a.data.order - b.data.order);
const journeys = (await getCollection('journeys')).sort((a, b) => a.data.order - b.data.order);

const graph = [
  webPage({ path: '/', name: page.title, description: page.description, type: 'WebPage', dateModified: page.updated }),
  faqPage('/', homeFaqs),
  itemList('Example journeys', journeys.map((j) => ({ name: j.data.title, path: `/journeys/${j.id}` }))),
  itemList('Destinations', destinations.map((d) => ({ name: d.data.name, path: `/destinations/${d.id}` }))),
];
---
<Base title={page.title} description={page.description} path="/" ogSlug="home" graph={graph} modified={page.updated}>
  <World />

  <section id="how" class="section how" aria-labelledby="how-h">
    <div class="wrap">
      <div class="split">
        <h2 id="how-h" class="h-lg" style="max-width:14ch">Not a package. A conversation.</h2>
        <p class="body-lg" style="margin:0;max-width:440px">Most agencies hand you a brochure itinerary. Rezo starts with a blank map and your own words, then plans the journey around you.</p>
      </div>
      <!-- The four steps are a real sequence, so they are drawn as stops on a road, like the route on the model. -->
      <ol class="road">
        {steps.map((s, i) => (
          <li style={`--i:${i}`}>
            <span class="road-pin" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
      <p class="callout plinth"><strong>Technology helps us keep track. It never replaces Rezo.</strong> Every itinerary and every price is reviewed and approved by him before you see it, and nothing is final until he says so.</p>
    </div>
  </section>

  <section id="where" class="section section--mist where" aria-labelledby="where-h">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(36px,4vw,56px)">
        <h2 id="where-h" class="h-lg" style="max-width:15ch">Where do you want to wake up?</h2>
        <p class="body-lg" style="margin:0;max-width:440px">Every region on the model is a place Rezo knows by its roads. Pick what moves you and he connects the dots.</p>
      </div>
      <div class="grid-auto" style="--min:290px;gap:44px 28px">
        {destinations.map((d) => <DestinationCard entry={d} />)}
      </div>
      <p class="note also"><strong>Also on Rezo’s map:</strong> Mtskheta, Borjomi, Vardzia, Racha, David Gareja, Martvili Canyon, and the small roads between them. <a href="/destinations" class="lnk">All destinations</a></p>
    </div>
  </section>

  <section id="journeys" class="section" aria-labelledby="journeys-h">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(36px,4vw,56px)">
        <h2 id="journeys-h" class="h-lg" style="max-width:14ch">Journeys Rezo might plan</h2>
        <p class="body-lg" style="margin:0;max-width:440px">Starting points, never fixed packages. Route, length, pace and price are always set for you.</p>
      </div>
      <div class="grid-auto" style="--min:330px;gap:36px 28px">
        {journeys.map((j) => <JourneyCard entry={j} />)}
      </div>
    </div>
  </section>

  <MeetRezo />

  <section id="fleet" class="section" aria-labelledby="fleet-h">
    <div class="wrap">
      <div class="split" style="margin-bottom:clamp(36px,4vw,56px)">
        <h2 id="fleet-h" class="h-lg" style="max-width:14ch">Five vehicles, one for every road</h2>
        <p class="body-lg" style="margin:0;max-width:440px">The vehicle is chosen after the route, never the other way round. <a href="/vehicles" class="lnk">About the vehicles</a></p>
      </div>
      <VehicleCards />
    </div>
  </section>

  {site.showPlaceholders && (
    <section class="section section--tight" aria-label="Testimonials (placeholder)">
      <div class="wrap">
        <h2 class="h-md" style="margin-bottom:12px">In travellers’ words</h2>
        <p class="body-lg" style="margin:0 0 36px;max-width:640px">Only genuine testimonials, shown with permission. Nothing appears here until Rezo has real ones to share.</p>
        <div class="grid-auto" style="--min:300px;gap:20px">
          {['photo with permission', 'trip dates', 'link to original post'].map((hint) => (
            <figure class="slot" style="margin:0;border-radius:var(--r);padding:28px 26px;min-height:190px;align-items:stretch;justify-content:space-between;text-align:left;gap:20px">
              <blockquote class="disp" style="margin:0;font-style:italic;font-size:22px;line-height:1.4;color:var(--slate)">[A real traveller’s quote about their journey.]</blockquote>
              <figcaption style="font-size:15px">[Name, country, trip]: {hint}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <ContactCta />

  <section id="faq" class="section" aria-labelledby="faq-h">
    <div class="wrap--narrow">
      <h2 id="faq-h" class="h-md" style="margin-bottom:36px">Questions travellers ask</h2>
      <Faq items={homeFaqs} />
      <p style="margin:28px 0 0"><a href="/faq" class="lnk">More questions and answers</a></p>
    </div>
  </section>

  <script>
    import '../scripts/home-world';
  </script>
</Base>

<style>
  /* ---------- How it works: four stops on a road ---------- */
  .road { --pin: 52px; position: relative; list-style: none; margin: clamp(48px, 6vw, 80px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 32px; }
  /* The road itself: the model's pale lane with the route's red dashes on it. */
  .road::before { content: ''; position: absolute; left: calc(var(--pin) / 2); right: 0; top: calc(var(--pin) / 2 - 7px); height: 14px; border-radius: 7px;
    background: linear-gradient(90deg, var(--red) 0 14px, transparent 14px 26px) 0 50% / 26px 3px repeat-x, #d6cfc0; }
  .road li { position: relative; }
  .road-pin { position: relative; display: inline-flex; align-items: center; justify-content: center; width: var(--pin); height: var(--pin);
    border-radius: 16px; background: var(--red); color: #fff; font: 600 20px/1 var(--font-ui); box-shadow: 0 5px 0 var(--red-deep), 0 16px 22px -12px rgba(158, 26, 40, .7); }
  .road h3 { margin: 26px 0 8px; font-size: var(--t-lg); line-height: 1.15; font-weight: 540; }
  .road p { margin: 0; color: var(--slate-2); font-size: 17px; line-height: 1.55; max-width: 34ch; }
  @media (max-width: 900px) {
    .road { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .road::before { left: calc(var(--pin) / 2 - 7px); right: auto; top: 0; bottom: 0; width: 14px; height: auto;
      background: linear-gradient(180deg, var(--red) 0 14px, transparent 14px 26px) 50% 0 / 3px 26px repeat-y, #d6cfc0; }
    .road li { padding-left: calc(var(--pin) + 22px); }
    .road-pin { position: absolute; left: 0; top: 0; }
    .road h3 { margin-top: 8px; }
  }
  .callout { margin: clamp(48px, 6vw, 80px) 0 0; padding: 24px 28px; max-width: 860px; font-size: var(--t-base); line-height: 1.55; color: var(--slate-2); }
  .callout strong { color: var(--ink); font-weight: 600; }
  .also { margin: clamp(40px, 5vw, 56px) 0 0; max-width: 900px; font-size: 17px; }
  .also strong { color: var(--ink); font-weight: 600; }
</style>
