---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import CtaBand from '../../components/CtaBand.astro';
import { photos } from '../../data/photos';
import { pageByPath } from '../../data/pages';
import { webPage, itemList, breadcrumbWithId } from '../../lib/schema';

const page = pageByPath('/guides');
const items = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides' }];
const graph = [
  webPage({ path: page.path, name: page.title, description: page.description, type: 'CollectionPage', crumbs, dateModified: page.updated }),
  breadcrumbWithId(page.path, crumbs),
  itemList('Georgia travel guides', items.map((g) => ({ name: g.data.title, path: `/guides/${g.id}` }))),
];
---
<Base title={page.title} description={page.description} path={page.path} ogSlug={page.slug} graph={graph} modified={page.updated}>
  <PageIntro eyebrow="Guides" title="Planning Georgia, plainly" summary="Practical notes on the things that decide a Georgia trip: when to go, how the wine works and how the mountain roads behave. Written in the voice we plan in: specific over superlative, and honest about limits." crumbs={crumbs} updated={page.updated} />
  <section class="section" style="padding-top:0">
    <div class="wrap grid-auto" style="--min:330px">
      {items.map((g) => (
        <article class="card card--stretched">
          {g.data.photo && <Image src={photos[g.data.photo].src} alt="" widths={[480, 768]} sizes="(min-width: 700px) 400px, 100vw" style="aspect-ratio:3/2;width:100%;height:auto;object-fit:cover;border-radius:8px" loading="lazy" />}
          <p class="card-eyebrow">{g.data.readingMinutes} min read</p>
          <h2 class="card-title card-title--sm disp"><a href={`/guides/${g.id}`} class="stretch" style="text-decoration:none">{g.data.title}</a></h2>
          <p class="card-text" style="flex:1">{g.data.summary.split('.')[0]}.</p>
          <span class="lnk">Read the guide <span aria-hidden="true" class="red">→</span></span>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
