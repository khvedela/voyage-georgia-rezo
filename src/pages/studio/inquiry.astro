---
import Dash from '../../layouts/Dash.astro';
import { MAP, roads } from '../../data/routes';
const route = [roads.tbilisiKazbegi, roads.kazbegiTelavi, roads.telaviKutaisi, roads.kutaisiBatumi];
const pins: [number, number][] = [[681, 387], [662, 228], [767, 354], [419, 294], [283, 405]];
---
<Dash title="New inquiry" path="/studio/inquiry">
  <header class="d-hd d-hd--rule" style="padding-block:10px">
    <a href="/studio" class="d-back" aria-label="Back to Today"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></a>
    <div style="flex:1;min-width:0">
      <h1 class="d-title" style="font-size:24px">Leila H.</h1>
      <p class="d-sub">Web form · received 1 h ago · sample data</p>
    </div>
    <span style="padding:3px 10px;border-radius:999px;background:var(--red);color:#fff;font-size:12px;font-weight:600">New</span>
  </header>
  <div class="d-main" style="padding:18px 20px 20px;gap:20px">
    <section aria-label="In their words" style="padding:18px 18px 20px;border-radius:14px;background:var(--paper);border:1px solid var(--line)">
      <p class="d-eyebrow">In their words</p>
      <p class="disp" style="margin:0;font-size:21px;line-height:1.3">“We have ten days in September. We’d love mountains, wine, old churches and a little sea — without exhausting travel days.”</p>
    </section>
    <section aria-label="Their answers">
      <dl style="margin:0;display:grid;grid-template-columns:96px 1fr;gap:10px 12px;font-size:15.5px">
        <dt style="color:var(--slate)">When</dt><dd style="margin:0">September · dates flexible</dd>
        <dt style="color:var(--slate)">Length</dt><dd style="margin:0">10 days</dd>
        <dt style="color:var(--slate)">Travellers</dt><dd style="margin:0">2 adults</dd>
        <dt style="color:var(--slate)">Pace</dt><dd style="margin:0">Slow &amp; spacious</dd>
        <dt style="color:var(--slate)">Budget</dt><dd style="margin:0">Comfortable</dd>
        <dt style="color:var(--slate)">Access</dt><dd style="margin:0">Nothing special</dd>
        <dt style="color:var(--slate)">Reply via</dt><dd style="margin:0">WhatsApp</dd>
      </dl>
      <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:6px"><span class="d-tag" style="padding:4px 12px;font-size:14px">Mountains</span><span class="d-tag" style="padding:4px 12px;font-size:14px">Wine</span><span class="d-tag" style="padding:4px 12px;font-size:14px">Churches</span><span class="d-tag" style="padding:4px 12px;font-size:14px">Black Sea</span></div>
    </section>
    <section aria-label="Assistant sketch" style="padding:16px;border-radius:14px;background:var(--mist)">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:6px">
        <p class="d-eyebrow" style="margin:0">Assistant sketch</p>
        <span style="padding:2px 9px;border-radius:999px;border:1px solid var(--line-3);font-size:11.5px;color:var(--slate-2)">Draft · only you see this</span>
      </div>
      <svg viewBox="60 60 880 490" style="width:100%;height:auto;display:block;border-radius:8px" role="img" aria-label="Map suggesting a route from Tbilisi to Kazbegi, Kakheti, Kutaisi and Batumi">
        <image href={MAP.srcWide} x="0" y="0" width={MAP.w} height={MAP.h} />
        <g fill="none" stroke="#D62839" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">{route.map((d) => <path d={d} />)}</g>
        <g fill="#D62839" stroke="#14161A" stroke-width="3.5">{pins.map(([x, y]) => <circle cx={x} cy={y} r="11" />)}</g>
        <g font-family="Inter Variable, Inter, sans-serif" font-size="34" fill="#14161A" font-weight="600" paint-order="stroke" stroke="#FAFAFA" stroke-width="8" stroke-linejoin="round"><text x="700" y="430">Tbilisi</text><text x="640" y="214" text-anchor="end">Kazbegi</text><text x="786" y="340">Kakheti</text><text x="419" y="262" text-anchor="middle">Kutaisi</text><text x="266" y="446" text-anchor="end">Batumi</text></g>
      </svg>
      <p style="margin:6px 0 0;font-size:14.5px;color:var(--slate-2)">Five bases fit ten days at a slow pace. It’s a starting thought — your route, your call.</p>
    </section>
    <section aria-label="Questions to ask">
      <p class="d-eyebrow">Worth asking first</p>
      <div style="display:flex;flex-wrap:wrap;gap:8px"><span class="d-pill">Arrival &amp; departure airports</span><span class="d-pill">Hotel style</span><span class="d-pill">Fixed dates?</span></div>
    </section>
  </div>
  <footer class="d-foot">
    <a href="/studio/builder" class="d-btn" style="min-height:54px">Start the itinerary</a>
    <div style="display:flex;gap:10px"><a href="/studio/inquiry" class="d-btn d-btn--line">Reply on WhatsApp</a><a href="/studio/builder" class="d-btn d-btn--line">Use a template</a></div>
  </footer>
</Dash>
