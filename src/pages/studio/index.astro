---
import Dash from '../../layouts/Dash.astro';
---
<Dash title="Today" path="/studio" nav>
  <header style="padding:18px 20px 10px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px">
    <div>
      <p class="d-sub" style="font-size:14px">Good morning, Rezo</p>
      <h1 class="disp" style="margin:0;font-weight:400;font-size:38px;line-height:1.05;letter-spacing:-.02em">Today</h1>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
      <span class="d-sync"><i aria-hidden="true"></i>Synced</span>
      <span style="font-size:11.5px;color:var(--slate)">Sample data</span>
    </div>
  </header>
  <div class="d-main" style="padding:6px 20px 20px;gap:22px">
    <section aria-labelledby="needs">
      <h2 id="needs" style="margin:0 0 10px;font-family:var(--font-body);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--red);font-weight:600">Needs you · 4</h2>
      <div style="display:flex;flex-direction:column;gap:12px">
        <a href="/studio/builder" class="d-card d-card--dark">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span style="padding:2px 10px;border-radius:999px;background:var(--red);font-size:12px;font-weight:600">Change request · v2</span><span style="font-size:12.5px;color:var(--line-3)">12 min ago</span></div>
          <h3>Anna &amp; Daniel</h3>
          <p style="margin:0;font-size:15.5px;color:#d4d4d8">“Could day 8 start later? We’d love a lie-in.”</p>
          <p style="margin:12px 0 0;font-size:15px;font-weight:600;color:#ff6b77">Revise to v3 →</p>
        </a>
        <a href="/studio/inquiry" class="d-card d-card--hot">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span style="display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--red)"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--red)"></span>New inquiry · web form</span><span style="font-size:12.5px;color:var(--slate)">1 h ago</span></div>
          <h3>Leila H.</h3>
          <p style="margin:0;font-size:15px;color:var(--slate)">10 days · 2 adults · September · slow pace</p>
          <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:6px"><span class="d-tag">Mountains</span><span class="d-tag">Wine</span><span class="d-tag">Churches</span><span class="d-tag">Black Sea</span></div>
        </a>
        <a href="/studio/inquiry" class="d-card">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span style="display:inline-flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:var(--red)"><span aria-hidden="true" style="width:8px;height:8px;border-radius:50%;background:var(--red)"></span>New inquiry · Messenger</span><span style="font-size:12.5px;color:var(--slate)">3 h ago</span></div>
          <h3>Tomás R.</h3>
          <p style="margin:0;font-size:15px;color:var(--slate)">7 days · 4 adults · October</p>
          <div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:6px"><span class="d-tag d-tag--ink">Wheelchair user in group</span><span class="d-tag">History</span></div>
        </a>
        <a href="/studio/inquiry" class="d-card">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span style="font-size:12.5px;font-weight:600;color:var(--slate)">Inquiry · web form</span><span style="font-size:12.5px;color:var(--slate)">Yesterday</span></div>
          <h3>James &amp; family</h3>
          <p style="margin:0;font-size:15px;color:var(--slate)">8 days · 2 adults, 2 children · July</p>
        </a>
      </div>
    </section>
    <section aria-labelledby="road">
      <h2 id="road" style="margin:0 0 10px;font-family:var(--font-body);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--red);font-weight:600">On the road</h2>
      <div style="padding:16px;border-radius:14px;background:var(--mist)">
        <div style="display:flex;justify-content:space-between;gap:10px;align-items:baseline"><strong class="disp" style="font-weight:500;font-size:20px">Karl &amp; Ines</strong><span style="font-size:14px;color:var(--slate)">Day 4 of 9</span></div>
        <p style="margin:4px 0 0;font-size:15px;color:var(--slate-2)">Tomorrow: Stepantsminda → Telavi · pickup 09:30</p>
        <p style="margin:2px 0 0;font-size:14px;color:var(--slate)">Driver: [name] · Vehicle: [assigned]</p>
      </div>
    </section>
  </div>
</Dash>
